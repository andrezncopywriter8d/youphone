generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MANAGER
  SELLER
  TECHNICIAN
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  SOLD
  SERVICE
  DEFECTIVE
  RETURNED
  TRADE_IN_PROCESS
  INACTIVE
}

enum DeviceCondition {
  NEW
  USED
  REFURBISHED
  TRADE_IN
}

enum MovementType {
  MANUAL_ENTRY
  SALE
  SALE_CANCELED
  ADJUSTMENT
  RETURN
}

enum SaleStatus {
  COMPLETED
  CANCELED
  REFUNDED
}

enum PaymentMethod {
  PIX
  CASH
  CREDIT_CARD
  DEBIT_CARD
  TRANSFER
  TRADE_IN
}

enum FinancialType {
  INCOME
  REVERSAL
  EXPENSE
}

enum ServiceOrderStatus {
  ENTRY
  WAITING_DIAGNOSIS
  WAITING_APPROVAL
  WAITING_PART
  IN_REPAIR
  IN_TESTING
  READY_FOR_PICKUP
  DELIVERED
  CANCELED
}

enum ServicePriority {
  NORMAL
  URGENT
}

enum ChecklistPhase {
  ENTRY
  FINAL
}

enum ChecklistResult {
  OK
  DEFECTIVE
  NOT_TESTED
  NOT_APPLICABLE
}

enum QuoteStatus {
  PENDING
  SENT
  APPROVED
  REFUSED
  EXPIRED
}

enum QuoteItemType {
  SERVICE
  PART
}

enum PartMovementType {
  ENTRY
  EXIT
  RESERVE
  CONSUME_IN_SERVICE_ORDER
  RETURN
  ADJUSTMENT
  LOSS
  DEFECT
  WARRANTY
}

enum ServiceOrderPartStatus {
  RESERVED
  USED
  RETURNED
  CANCELED
}

enum ServicePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

model User {
  id                   String                @id @default(cuid())
  name                 String
  email                String                @unique
  passwordHash         String
  role                 Role                  @default(SELLER)
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  movements            InventoryMovement[]
  sales                Sale[]                @relation("CreatedSales")
  canceledSales        Sale[]                @relation("CanceledSales")
  auditLogs            AuditLog[]
  createdServiceOrders ServiceOrder[]        @relation("CreatedServiceOrders")
  serviceHistories     ServiceOrderHistory[]
  diagnostics          ServiceDiagnostic[]   @relation("DiagnosedBy")
  servicePayments      ServiceOrderPayment[]
}

model Customer {
  id            String         @id @default(cuid())
  name          String
  phone         String
  cpf           String?        @unique
  email         String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sales         Sale[]
  serviceOrders ServiceOrder[]

  @@index([name])
  @@index([phone])
}

model ProductVariant {
  id        String          @id @default(cuid())
  brand     String          @default("Apple")
  model     String
  storage   String
  color     String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  units     InventoryUnit[]

  @@unique([brand, model, storage, color])
  @@index([model])
}

model InventoryUnit {
  id               String              @id @default(cuid())
  productVariantId String
  internalCode     String              @unique
  imei1            String              @unique
  imei2            String?             @unique
  serialNumber     String?             @unique
  condition        DeviceCondition
  batteryHealth    Int?
  hasBox           Boolean             @default(false)
  purchaseCost     Decimal             @db.Decimal(12, 2)
  salePrice        Decimal             @db.Decimal(12, 2)
  minimumSalePrice Decimal?            @db.Decimal(12, 2)
  status           InventoryStatus     @default(AVAILABLE)
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?
  productVariant   ProductVariant      @relation(fields: [productVariantId], references: [id])
  movements        InventoryMovement[]
  saleItems        SaleItem[]

  @@index([status])
  @@index([imei1])
  @@index([serialNumber])
}

model InventoryMovement {
  id              String           @id @default(cuid())
  inventoryUnitId String
  type            MovementType
  fromStatus      InventoryStatus?
  toStatus        InventoryStatus
  referenceType   String?
  referenceId     String?
  notes           String?
  userId          String
  createdAt       DateTime         @default(now())
  inventoryUnit   InventoryUnit    @relation(fields: [inventoryUnitId], references: [id])
  user            User             @relation(fields: [userId], references: [id])

  @@index([inventoryUnitId, createdAt])
}

model Sale {
  id            String                 @id @default(cuid())
  number        String                 @unique
  customerId    String?
  status        SaleStatus             @default(COMPLETED)
  grossTotal    Decimal                @db.Decimal(12, 2)
  discountTotal Decimal                @default(0) @db.Decimal(12, 2)
  netTotal      Decimal                @db.Decimal(12, 2)
  createdById   String
  canceledById  String?
  canceledAt    DateTime?
  cancelReason  String?
  createdAt     DateTime               @default(now())
  customer      Customer?              @relation(fields: [customerId], references: [id])
  createdBy     User                   @relation("CreatedSales", fields: [createdById], references: [id])
  canceledBy    User?                  @relation("CanceledSales", fields: [canceledById], references: [id])
  items         SaleItem[]
  payments      Payment[]
  financial     FinancialTransaction[]

  @@index([createdAt])
  @@index([status])
}

model SaleItem {
  id              String        @id @default(cuid())
  saleId          String
  inventoryUnitId String
  description     String
  imeiSnapshot    String
  costSnapshot    Decimal       @db.Decimal(12, 2)
  unitPrice       Decimal       @db.Decimal(12, 2)
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  finalPrice      Decimal       @db.Decimal(12, 2)
  sale            Sale          @relation(fields: [saleId], references: [id])
  inventoryUnit   InventoryUnit @relation(fields: [inventoryUnitId], references: [id])

  @@unique([saleId, inventoryUnitId])
}

model Payment {
  id           String        @id @default(cuid())
  saleId       String
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  feeAmount    Decimal       @default(0) @db.Decimal(12, 2)
  netAmount    Decimal       @db.Decimal(12, 2)
  installments Int           @default(1)
  createdAt    DateTime      @default(now())
  sale         Sale          @relation(fields: [saleId], references: [id])
}

model FinancialTransaction {
  id          String        @id @default(cuid())
  saleId      String?
  type        FinancialType
  description String
  amount      Decimal       @db.Decimal(12, 2)
  createdAt   DateTime      @default(now())
  sale        Sale?         @relation(fields: [saleId], references: [id])

  @@index([createdAt])
}

model Technician {
  id          String              @id @default(cuid())
  name        String
  phone       String?
  email       String?
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  orders      ServiceOrder[]
  diagnostics ServiceDiagnostic[]

  @@index([name])
  @@index([active])
}

model ServiceOrder {
  id                  String                 @id @default(cuid())
  number              String                 @unique
  publicToken         String                 @unique
  customerId          String
  createdById         String
  technicianId        String?
  warrantySourceId    String?
  status              ServiceOrderStatus     @default(ENTRY)
  priority            ServicePriority        @default(NORMAL)
  category            String                 @default("Smartphone")
  brand               String                 @default("Apple")
  model               String
  color               String?
  capacity            String?
  imei                String?
  imei2               String?
  serial              String?
  modelNumber         String?
  unlockPassword      String?
  accessories         String?
  deviceNotes         String?
  reportedIssues      String[]
  customerDescription String?
  internalNote        String?
  expectedAt          DateTime?
  readyAt             DateTime?
  deliveredAt         DateTime?
  canceledAt          DateTime?
  paymentStatus       ServicePaymentStatus   @default(UNPAID)
  totalServices       Decimal                @default(0) @db.Decimal(12, 2)
  totalParts          Decimal                @default(0) @db.Decimal(12, 2)
  discountTotal       Decimal                @default(0) @db.Decimal(12, 2)
  totalCharged        Decimal                @default(0) @db.Decimal(12, 2)
  totalCost           Decimal                @default(0) @db.Decimal(12, 2)
  warrantyDays        Int?
  warrantyStartAt     DateTime?
  warrantyEndAt       DateTime?
  warrantyNotes       String?
  deliveredBy         String?
  pickedUpBy          String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  customer            Customer               @relation(fields: [customerId], references: [id])
  createdBy           User                   @relation("CreatedServiceOrders", fields: [createdById], references: [id])
  technician          Technician?            @relation(fields: [technicianId], references: [id])
  warrantySource      ServiceOrder?          @relation("WarrantyReturns", fields: [warrantySourceId], references: [id])
  warrantyReturns     ServiceOrder[]         @relation("WarrantyReturns")
  histories           ServiceOrderHistory[]
  checklistItems      ServiceChecklistItem[]
  diagnostic          ServiceDiagnostic?
  quote               ServiceQuote?
  parts               ServiceOrderPart[]
  payments            ServiceOrderPayment[]
  attachments         ServiceAttachment[]

  @@index([status])
  @@index([priority])
  @@index([customerId])
  @@index([technicianId])
  @@index([createdAt])
  @@index([expectedAt])
  @@index([imei])
  @@index([serial])
  @@index([model])
}

model ServiceOrderHistory {
  id             String              @id @default(cuid())
  serviceOrderId String
  userId         String
  action         String
  previousStatus ServiceOrderStatus?
  newStatus      ServiceOrderStatus?
  notes          String?
  metadata       Json?
  createdAt      DateTime            @default(now())
  serviceOrder   ServiceOrder        @relation(fields: [serviceOrderId], references: [id])
  user           User                @relation(fields: [userId], references: [id])

  @@index([serviceOrderId, createdAt])
  @@index([userId])
}

model ServiceChecklistItem {
  id             String          @id @default(cuid())
  serviceOrderId String
  phase          ChecklistPhase
  item           String
  result         ChecklistResult @default(NOT_TESTED)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  serviceOrder   ServiceOrder    @relation(fields: [serviceOrderId], references: [id])

  @@unique([serviceOrderId, phase, item])
  @@index([serviceOrderId, phase])
}

model ServiceDiagnostic {
  id                 String       @id @default(cuid())
  serviceOrderId     String       @unique
  technicianId       String?
  diagnosedById      String?
  foundIssue         String
  probableCause      String?
  recommendedService String?
  technicalNote      String?
  estimatedTime      String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  serviceOrder       ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  technician         Technician?  @relation(fields: [technicianId], references: [id])
  diagnosedBy        User?        @relation("DiagnosedBy", fields: [diagnosedById], references: [id])
}

model ServiceQuote {
  id               String             @id @default(cuid())
  serviceOrderId   String             @unique
  status           QuoteStatus        @default(PENDING)
  subtotalParts    Decimal            @default(0) @db.Decimal(12, 2)
  subtotalServices Decimal            @default(0) @db.Decimal(12, 2)
  discount         Decimal            @default(0) @db.Decimal(12, 2)
  total            Decimal            @default(0) @db.Decimal(12, 2)
  totalCost        Decimal            @default(0) @db.Decimal(12, 2)
  profit           Decimal            @default(0) @db.Decimal(12, 2)
  margin           Decimal            @default(0) @db.Decimal(7, 2)
  sentAt           DateTime?
  approvedAt       DateTime?
  approvalMethod   String?
  responsibleId    String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  serviceOrder     ServiceOrder       @relation(fields: [serviceOrderId], references: [id])
  items            ServiceQuoteItem[]
}

model ServiceQuoteItem {
  id          String        @id @default(cuid())
  quoteId     String
  partId      String?
  type        QuoteItemType
  description String
  quantity    Int           @default(1)
  cost        Decimal       @default(0) @db.Decimal(12, 2)
  price       Decimal       @db.Decimal(12, 2)
  quote       ServiceQuote  @relation(fields: [quoteId], references: [id])
  part        Part?         @relation(fields: [partId], references: [id])
}

model Part {
  id              String              @id @default(cuid())
  sku             String              @unique
  barcode         String?             @unique
  name            String
  category        String
  brand           String?
  compatibleModel String?
  quality         String?
  supplier        String?
  cost            Decimal             @default(0) @db.Decimal(12, 2)
  price           Decimal             @default(0) @db.Decimal(12, 2)
  quantity        Int                 @default(0)
  reserved        Int                 @default(0)
  minimumStock    Int                 @default(0)
  location        String?
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  compatibilities PartCompatibility[]
  movements       PartMovement[]
  serviceParts    ServiceOrderPart[]
  quoteItems      ServiceQuoteItem[]

  @@index([name])
  @@index([category])
  @@index([compatibleModel])
}

model PartCompatibility {
  id     String @id @default(cuid())
  partId String
  model  String
  part   Part   @relation(fields: [partId], references: [id])

  @@unique([partId, model])
  @@index([model])
}

model PartMovement {
  id             String           @id @default(cuid())
  partId         String
  serviceOrderId String?
  type           PartMovementType
  quantity       Int
  reason         String?
  userId         String
  createdAt      DateTime         @default(now())
  part           Part             @relation(fields: [partId], references: [id])

  @@index([partId, createdAt])
  @@index([serviceOrderId])
}

model ServiceOrderPart {
  id             String                 @id @default(cuid())
  serviceOrderId String
  partId         String
  quantity       Int
  unitCost       Decimal                @default(0) @db.Decimal(12, 2)
  unitPrice      Decimal                @default(0) @db.Decimal(12, 2)
  status         ServiceOrderPartStatus @default(RESERVED)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  serviceOrder   ServiceOrder           @relation(fields: [serviceOrderId], references: [id])
  part           Part                   @relation(fields: [partId], references: [id])

  @@index([serviceOrderId])
  @@index([partId])
}

model ServiceOrderPayment {
  id             String        @id @default(cuid())
  serviceOrderId String
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  userId         String
  notes          String?
  createdAt      DateTime      @default(now())
  serviceOrder   ServiceOrder  @relation(fields: [serviceOrderId], references: [id])
  user           User          @relation(fields: [userId], references: [id])

  @@index([serviceOrderId, createdAt])
}

model ServiceAttachment {
  id             String       @id @default(cuid())
  serviceOrderId String
  label          String
  url            String
  kind           String       @default("photo")
  createdAt      DateTime     @default(now())
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id])

  @@index([serviceOrderId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}
